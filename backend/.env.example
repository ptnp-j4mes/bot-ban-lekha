NODE_ENV=development
APP_PORT=3000
APP_TIMEZONE=Asia/Bangkok
LOG_LEVEL=info

DATABASE_URL=postgresql://billing:billing@localhost:5433/line_oa_billing

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

ADMIN_API_KEY=change-me
INTERNAL_JOB_API_KEY=change-me

# Admin login (LINE Login channel — separate from Messaging API) + JWT session
JWT_SECRET=dev-insecure-jwt-secret-change-me
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin
FRONTEND_URL=http://localhost:5173
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:8787/api/auth/line/callback

# Customer-facing LIFF app (self-service balance/installments/payments). Separate channel
# from LINE_LOGIN_CHANNEL_ID above (that one is for admin login).
LINE_LIFF_CHANNEL_ID=

PAYMENT_AUTO_APPROVE_ENABLED=false

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

# Google Drive service-account OAuth (server-to-server). Leave empty until ready.
# The service account must have access to the root folder in Google Drive.
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
GOOGLE_DRIVE_ROOT_FOLDER_ID=

# AWS S3 / S3-compatible storage. Required when STORAGE_DRIVER=s3.
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Optional for MinIO, Cloudflare R2, Wasabi, etc. AWS S3 uses the default endpoint.
S3_ENDPOINT=
# Optional public/CDN URL. Empty = backend reads private objects with signed requests.
S3_PUBLIC_BASE_URL=
S3_PREFIX=slips

# Cloudflare R2 usage monitor. The token needs R2 Storage Read permission.
# Account ID can be parsed from the standard R2 endpoint, but setting it explicitly is recommended.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
R2_QUOTA_GB=10
R2_ALERT_THRESHOLD_PERCENT=80
R2_METRICS_DAYS=30

# Slip image retention (days) before the local file is purged; 0 = purge right after OCR/process.
# Org-level / system-default settings (if set) override this.
SLIP_RETENTION_DAYS=30

OCR_PROVIDER=gemini        # mock | gemini
OCR_API_KEY=                # Gemini (Google AI Studio) API key when OCR_PROVIDER=gemini
OCR_MODEL=gemini-3.1-flash-lite

MAX_SLIP_FILE_SIZE_MB=10

# OCR guards
OCR_GUARDS_ENABLED=true      # false = disable the per-user OCR rate limit
OCR_RATE_MAX=10              # max slips per user per window
OCR_RATE_WINDOW_SEC=3600     # rate-limit window (seconds)

# Bill late-payment notice shown at bottom of every bill (configurable per group)
BILL_FOOTER=
