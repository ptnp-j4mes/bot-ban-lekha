{
  "name": "line-oa-bill-reminder-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/app.ts",
    "start": "bun src/app.ts",
    "tunnel": "cloudflared tunnel --url http://localhost:8787",
    "test": "bun --env-file=.env.test test",
    "db:test:init": "docker exec line-oa-postgres psql -U billing -d postgres -c \"CREATE DATABASE line_oa_billing_test\" 2>/dev/null; DATABASE_URL=postgresql://billing:billing@localhost:5433/line_oa_billing_test bunx prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "bun prisma/seed.ts",
    "db:generate": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "elysia": "^1.2.10",
    "pino": "^10.3.1"
  },
  "devDependencies": {
    "prisma": "^6.2.1",
    "@types/bun": "latest"
  }
}
