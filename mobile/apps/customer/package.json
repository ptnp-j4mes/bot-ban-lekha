{
  "name": "bill-customer-mobile",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "ios:pods": "pod install --project-directory=ios",
    "ios:debug:sim": "xcodebuild -workspace ios/BillCustomer.xcworkspace -scheme BillCustomer -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' -derivedDataPath build/debug-simulator build CODE_SIGNING_ALLOWED=NO",
    "ios:debug:device": "xcodebuild -workspace ios/BillCustomer.xcworkspace -scheme BillCustomer -configuration Debug -sdk iphoneos -destination 'generic/platform=iOS' -derivedDataPath build/debug-device build CODE_SIGNING_ALLOWED=NO",
    "ios:archive": "xcodebuild -workspace ios/BillCustomer.xcworkspace -scheme BillCustomer -configuration Release -archivePath build/BillCustomer.xcarchive archive",
    "ios:export:adhoc": "xcodebuild -exportArchive -archivePath build/BillCustomer.xcarchive -exportPath build/BillCustomer-ad-hoc -exportOptionsPlist ios/ExportOptions-AdHoc.plist",
    "lint": "eslint .",
    "start": "react-native start",
    "test": "jest"
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.87.0",
    "@react-navigation/native": "^7.3.17",
    "@react-navigation/native-stack": "^7.18.9",
    "@tanstack/react-query": "^5.102.2",
    "@xmartlabs/react-native-line": "^6.0.1",
    "lucide-react-native": "^1.33.0",
    "react": "19.2.3",
    "react-native": "0.87.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.5.2",
    "react-native-screens": "^4.27.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.87.0",
    "@react-native/eslint-config": "0.87.0",
    "@react-native/jest-preset": "0.87.0",
    "@react-native/metro-config": "0.87.0",
    "@react-native/typescript-config": "0.87.0",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.13",
    "@types/react": "^19.2.0",
    "@types/react-test-renderer": "^19.1.0",
    "eslint": "^8.19.0",
    "jest": "^29.6.3",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">= 22.11.0"
  }
}
