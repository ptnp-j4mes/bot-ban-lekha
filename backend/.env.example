NODE_ENV=development
APP_PORT=3000
APP_TIMEZONE=Asia/Bangkok

DATABASE_URL=postgresql://billing:billing@localhost:5433/line_oa_billing

LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

ADMIN_API_KEY=change-me
INTERNAL_JOB_API_KEY=change-me

# Admin login (LINE Login channel — separate from Messaging API) + JWT session
JWT_SECRET=dev-insecure-jwt-secret-change-me
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin
FRONTEND_URL=http://localhost:5173
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:8787/api/auth/line/callback

PAYMENT_AUTO_APPROVE_ENABLED=false

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

OCR_PROVIDER=mock          # mock | gemini
OCR_API_KEY=                # Gemini (Google AI Studio) API key when OCR_PROVIDER=gemini
OCR_MODEL=gemini-2.5-flash

MAX_SLIP_FILE_SIZE_MB=10

# Slip retention: days to keep a slip image on local disk before the purge job deletes it.
# 0 = purge right after OCR/processing. Org/system settings can override this default.
SLIP_RETENTION_DAYS=30

# OCR guards
OCR_RATE_MAX=10              # max slips per user per window
OCR_RATE_WINDOW_SEC=3600     # rate-limit window (seconds)

# Bill late-payment notice shown at bottom of every bill (configurable per group)
BILL_FOOTER=
