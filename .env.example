# ── Docker Compose local environment ─────────────────────────────────────────
# Copy this file to .env and fill in real values before running:
#   cp .env.example .env

# Postgres credentials (shared by docker-compose postgres service and backend)
POSTGRES_USER=billing
POSTGRES_PASSWORD=billing
POSTGRES_DB=line_oa_billing

# ── Backend settings (see backend/.env.example for full list) ─────────────────
NODE_ENV=development
APP_PORT=8787
APP_TIMEZONE=Asia/Bangkok

# These must NOT keep insecure defaults in a real environment
ADMIN_API_KEY=change-me
INTERNAL_JOB_API_KEY=change-me
JWT_SECRET=dev-insecure-jwt-secret-change-me
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin

FRONTEND_URL=http://localhost:5173

# LINE Messaging API (leave empty to skip signature verification in dev)
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# LINE Login (for admin login via LINE account)
LINE_LOGIN_CHANNEL_ID=
LINE_LOGIN_CHANNEL_SECRET=
LINE_LOGIN_REDIRECT_URI=http://localhost:8787/api/auth/line/callback

PAYMENT_AUTO_APPROVE_ENABLED=false

STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage

OCR_PROVIDER=mock
OCR_API_KEY=
OCR_MODEL=gemini-2.5-flash

MAX_SLIP_FILE_SIZE_MB=10
OCR_RATE_MAX=10
OCR_RATE_WINDOW_SEC=3600
BILL_FOOTER=
